<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Async/Await Lab</title>
    <style>
        body { font-family: sans-serif; padding: 20px; }
        #post-list { list-style-type: none; padding: 0; }
        li { border: 1px solid #ccc; margin-bottom: 15px; padding: 15px; border-radius: 8px; }
        h1 { font-size: 1.2rem; color: #333; }
        p { color: #666; }
    </style>
</head>
<body>

    <h2>Posts</h2>
    <!-- The ul element required by the instructions -->
    <ul id="post-list"></ul>

    <!-- Link to your JavaScript file -->
    <script src="script.js"></script>
</body>
</html>
// ---------------------------------------------------------
// Step 3: Display Posts
// ---------------------------------------------------------
function displayPosts(posts) {
    // Get the ul element by its id
    const ul = document.getElementById('post-list');

    // Loop through the posts list
    posts.forEach(post => {
        // Create an li element
        const li = document.createElement('li');
        
        // Create an h1 element
        const h1 = document.createElement('h1');
        // Set textContent to the title of the post
        h1.textContent = post.title;
        
        // Create a p element
        const p = document.createElement('p');
        // Set textContent to the body of the post
        p.textContent = post.body;
        
        // Append h1 and p to li
        li.appendChild(h1);
        li.appendChild(p);
        
        // Append li to the ul
        ul.appendChild(li);
    });
}

// ---------------------------------------------------------
// Step 2 & 4: Refactor with Async/Await
// ---------------------------------------------------------

// Create function to house fetch and apply async to function
async function fetchAndDisplayPosts() {
    try {
        // Apply await to fetch
        const response = await fetch('https://jsonplaceholder.typicode.com/posts');
        
        // Check if the response is ok (status 200-299)
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        // Parse the JSON data
        const data = await response.json();
        
        // Call displayPosts() after fetch
        displayPosts(data);

    } catch (error) {
        console.error('Error fetching the posts:', error);
    }
}

// Call the function to execute it
fetchAndDisplayPosts();